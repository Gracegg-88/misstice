# ── Supabase ────────────────────────────────────────────────────────────────
# Copiez ce fichier en « .env.local » et remplissez avec les valeurs de votre
# projet Supabase :  Dashboard → Project Settings → API
#
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=VOTRE_CLE_ANON_PUBLIQUE

# ── Cloudinary (hébergement des images/vidéos d'inspiration) ────────────────
# Upload SIGNÉ : le secret reste côté serveur. Valeurs dans Cloudinary →
# Settings → API Keys (Cloud name, une API Key avec droit d'upload, + secret).
#
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=VOTRE_CLOUD_NAME
NEXT_PUBLIC_CLOUDINARY_API_KEY=VOTRE_API_KEY
CLOUDINARY_API_SECRET=VOTRE_API_SECRET

# ── Brevo SMTP (emails RSVP aux invités — sans domaine) ─────────────────────
# Brevo → SMTP & API → SMTP : login + clé SMTP (xsmtpsib-…).
# Senders → vérifiez une adresse expéditeur (une Gmail suffit, confirmée mail).
#
BREVO_SMTP_LOGIN=xxxxxx@smtp-brevo.com
BREVO_SMTP_KEY=xsmtpsib-...
BREVO_SENDER_EMAIL=votre-adresse-verifiee@exemple.com
BREVO_SENDER_NAME=Misstice

# ── Stripe Connect (paiement prestataires, séquestre) ────────────────────────
# Dashboard Stripe → Developers → API keys (clé secrète et publiable).
#
# DEUX endpoints webhook distincts pointent vers la MÊME URL
# /api/stripe/webhook (Stripe impose deux « destinations » séparées selon le
# périmètre choisi à leur création) :
#   1. Périmètre "Comptes connectés" → événement account.updated
#      → STRIPE_WEBHOOK_SECRET
#   2. Périmètre "Votre compte" → événement checkout.session.completed
#      (le paiement client a lieu sur le compte plateforme, pas sur un
#      compte connecté) → STRIPE_WEBHOOK_SECRET_ACCOUNT
# Chaque destination a son propre "Signing secret" (whsec_...), à copier
# depuis Dashboard → Developers → Webhooks → cliquez sur la destination.
#
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_WEBHOOK_SECRET_ACCOUNT=whsec_...

# ── OTP (inscription) ────────────────────────────────────────────────────────
# Email : configuré côté Supabase Dashboard (Authentication → Emails → SMTP)
# avec les identifiants Brevo ci-dessus — rien à ajouter ici.
#
# SMS : géré par supabase/functions/send-sms-hook, qui a besoin de
# SEND_SMS_HOOK_SECRET et BREVO_API_KEY (clé API Brevo, différente de la clé
# SMTP). Ce sont des SECRETS SUPABASE (`supabase secrets set ...`), pas des
# variables Next.js/Vercel — ils ne vont donc PAS dans ce fichier.
